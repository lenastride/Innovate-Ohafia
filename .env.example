# Public site address used in Flutterwave's payment callback URL. Set this to your live HTTPS domain.
NUXT_PUBLIC_SITE_URL=https://www.innovateohafia.com

# Flutterwave Standard credentials. Keep the secret key and webhook hash on the server only.
NUXT_PUBLIC_FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-your-public-key
NUXT_FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-your-secret-key

# Create a long random value, then set the same value as the webhook secret hash in Flutterwave Dashboard.
NUXT_FLUTTERWAVE_WEBHOOK_HASH=replace-with-a-long-random-webhook-hash

# Community registrations: create the `community_members` table in Supabase before enabling these.
# Keep all values below private; do not use the Supabase anon key here.
NUXT_SUPABASE_URL=https://your-project.supabase.co
NUXT_SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
NUXT_COMMUNITY_MEMBERS_TABLE=community_members

# Welcome email is delivered through Resend after a successful Supabase upsert.
NUXT_RESEND_API_KEY=re_your-resend-api-key
NUXT_COMMUNITY_WELCOME_FROM="Innovate Ohafia <community@your-domain.com>"
NUXT_COMMUNITY_WHATSAPP_GROUP_URL=https://chat.whatsapp.com/your-group-invite-code
